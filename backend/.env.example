# ═══════════════════════════════════════════════════════════════
# PolicyGuard AP — Environment Variables
# Copy this file to .env and fill in your real values
# ═══════════════════════════════════════════════════════════════

# ── Data Layer: "local" (SQLite mock ERP) or "airtable" ───────
ERP_DATA_SOURCE=local

# ── Airtable (Optional if ERP_DATA_SOURCE=local) ───────────────
AIRTABLE_API_KEY=pat_XXXXXXXXXXXXXXXXX
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXXXX

# ── Slack Integration ─────────────────────────────────────────
SLACK_BOT_TOKEN=xoxb-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
SLACK_SIGNING_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
SLACK_CHANNEL_ID=C0XXXXXXXXX

# ── Google Gemini AI (Multimodal PDF Ingestion) ───────────────
GEMINI_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXX
GEMINI_MODEL=gemini-flash-lite-latest

# ── App Settings ──────────────────────────────────────────────
BUSINESS_DATE=2026-10-09T18:00:00+05:30
LOG_LEVEL=INFO
